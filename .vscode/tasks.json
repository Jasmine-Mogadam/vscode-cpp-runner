{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C++: Build Project",
      "command": "make",
      "args": ["all"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$gcc"],
      "detail": "Compiler: g++"
    },
    {
      "type": "shell",
      "label": "C++: Build Tests",
      "command": "make",
      "args": ["run_tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$gcc"],
      "detail": "Compiler: g++"
    },
    {
      "type": "shell",
      "label": "C++: Run Tests",
      "command": "make",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build and run tests"
    },
    {
      "type": "cppbuild",
      "label": "C/C++: clang build active file",
      "command": "/usr/bin/clang++",
      "args": [
        "-std=gnu++17",
        "-fcolor-diagnostics",
        "-fansi-escape-codes",
        "-g",
        "-I${workspaceFolder}/include",
        "-I/opt/homebrew/include",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-L/opt/homebrew/lib",
        "-lgtest",
        "-lgtest_main",
        "-lgmock",
        "-pthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ]
}
